PORT=4000

# Long random string used to sign login tokens. Change this before deploying.
JWT_SECRET=replace_with_a_long_random_string

# Leave blank to run the AI assistant in offline fallback mode.
# Set this to enable real AI replies from the Claude API.
ANTHROPIC_API_KEY=

# Check https://docs.claude.com for the current model slugs before deploying.
CLAUDE_MODEL=claude-sonnet-4-5

# Secret code required to register an Admin account (change this).
ADMIN_CODE=letmein-admin
